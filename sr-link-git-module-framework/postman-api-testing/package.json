{
  "name": "sr-link-git-module-framework-testing",
  "version": "1.0.0",
  "description": "Sr Link — Git submodule-style layout with Newman Postman tests and historical analytics dashboard",
  "scripts": {
    "test": "newman run collections/jsonplaceholder-crud.postman_collection.json -r cli,htmlextra --reporter-htmlextra-export reports/newman-report.html",
    "test:dashboard": "newman-dashboard collections/jsonplaceholder-crud.postman_collection.json",
    "analytics:run": "analytics-dashboard run collections/jsonplaceholder-crud.postman_collection.json --config dashboard.config.ts",
    "analytics:generate": "analytics-dashboard generate --config dashboard.config.ts"
  },
  "devDependencies": {
    "historical-analytics-dashboard": "file:../..",
    "newman": "^6.2.2",
    "newman-reporter-dashboard-wrapper": "^1.0.4",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
